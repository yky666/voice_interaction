VOICE_HTTP_HOST=0.0.0.0
VOICE_HTTP_PORT=8083
VOICE_MEMORY_DB_PATH=

# asr backend: mock | command | http | openai_compatible | faster_whisper_local
VOICE_ASR_MODE=mock
VOICE_ASR_COMMAND=
VOICE_ASR_HTTP_URL=
VOICE_ASR_TIMEOUT_SEC=30
VOICE_ASR_MOCK_TEXT=小智，请介绍一下你自己。
VOICE_ASR_API_BASE=https://api.openai.com/v1
VOICE_ASR_API_KEY=
VOICE_ASR_MODEL=gpt-4o-mini-transcribe
VOICE_ASR_LANGUAGE=zh
VOICE_ASR_DEVICE=auto
VOICE_ASR_COMPUTE_TYPE=auto
VOICE_ASR_BEAM_SIZE=5

# llm backend: mock | command | http | openai_compatible
VOICE_LLM_MODE=mock
VOICE_LLM_COMMAND=
VOICE_LLM_HTTP_URL=
VOICE_LLM_TIMEOUT_SEC=60
VOICE_LLM_API_BASE=https://api.openai.com/v1
VOICE_LLM_API_KEY=
VOICE_LLM_MODEL=gpt-4o-mini
VOICE_LLM_TEMPERATURE=0.2
VOICE_LLM_MAX_OUTPUT_TOKENS=400

# tts backend: mock | command | http | openai_compatible
VOICE_TTS_MODE=mock
VOICE_TTS_COMMAND=
VOICE_TTS_HTTP_URL=
VOICE_TTS_TIMEOUT_SEC=60
VOICE_TTS_API_BASE=https://api.openai.com/v1
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
VOICE_TTS_AUDIO_FORMAT=wav

# dialog manager behavior
VOICE_SYSTEM_PROMPT="You are a polite, safety-aware robot assistant. Speak briefly, clearly, and helpfully."
VOICE_STYLE_PROMPT="Use a calm, friendly, and concise speaking style. If an action is unsafe or unclear, ask for confirmation."
VOICE_RESPONSE_FORMAT_PROMPT="Return JSON only with keys: reply_text, action_prompt, should_forward_action, should_execute_motion, skill_name, skill_args, memory_key, memory_value."
VOICE_MEMORY_RECENT_LIMIT=12
VOICE_ENABLE_ACTION_FORWARD=true
VOICE_ACTION_SERVICE_URL=http://127.0.0.1:8081/infer
VOICE_ACTION_TIMEOUT_SEC=60
VOICE_ENABLE_G1_EXECUTE=false
VOICE_G1_EXECUTE_URL=http://127.0.0.1:8082/execute
VOICE_G1_TIMEOUT_SEC=60
VOICE_DEFAULT_IMAGE_B64=
VOICE_ENABLE_COMFORT_ACTIONS=true
VOICE_ENABLE_SONG_MEMORY=true
VOICE_MEDIA_LIBRARY_JSON=
VOICE_ENABLE_SKILL_ROUTER=true
VOICE_G1_PROGRAM_URL=http://127.0.0.1:8082/run_program
VOICE_SKILL_PROGRAM_MAP='{"comfort_hug":"sdk_arm_hug","handshake":"sdk_arm_shake_hand","high_five":"sdk_arm_high_five","greet_bow":"greet_bow","left_wave":"left_wave","right_wave":"right_wave"}'
VOICE_SKILL_EXECUTE_MOTION=false
VOICE_SKILL_DT_SEC=0.05
VOICE_SKILL_SCALE=1.0
VOICE_SKILL_REPEAT=1

# wake word
VOICE_WAKE_WORD_ENABLED=false
VOICE_WAKE_WORD=小智
VOICE_WAKE_DURATION_SEC=30

# live audio loop and local I/O
VOICE_SERVICE_TURN_URL=http://127.0.0.1:8083/turn
VOICE_SESSION_ID=robot-companion-session
VOICE_AUDIO_INPUT_DEVICE=default
VOICE_AUDIO_OUTPUT_DEVICE=default
VOICE_AUDIO_SAMPLE_RATE=16000
VOICE_AUDIO_CHANNELS=1
VOICE_AUDIO_CHUNK_MS=30
VOICE_VAD_THRESHOLD=700
VOICE_VAD_START_CHUNKS=3
VOICE_VAD_END_SILENCE_SEC=1.0
VOICE_MAX_RECORD_SEC=12
VOICE_ENABLE_BARGE_IN=true
VOICE_PLAYBACK_BACKEND=aplay
